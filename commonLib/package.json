		"build:pro": "webpack --config ./webpackConfig/webpack.config.pro.js --progress",
		"rs:dev": "cross-env NODE_ENV=development rspack dev --config ./rspackConfig/rspack.config.js",
		"rs:build": "cross-env NODE_ENV=production rspack build --config ./rspackConfig/rspack.config.js",
		"rs:buildAndDeploy": "cross-env NODE_ENV=production rspack build --config ./rspackConfig/rspack.config.js && npx wrangler pages deploy ./dist",
